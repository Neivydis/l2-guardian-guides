---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
const { title='L2 Guardian Guides', lang='en' } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#02060d"/><title>{title}</title><ClientRouter /></head><body><Header lang={lang}/><slot/><Footer lang={lang}/></body></html>
<script is:inline>
  function revealSearchedFragment(){
    const phrase=new URLSearchParams(location.search).get('find');
    if(!phrase)return;
    const revealKey=`${location.pathname}${location.search}`;
    if(document.documentElement.dataset.revealedFind===revealKey)return;
    const normalise=value=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ').trim();
    const targetText=normalise(phrase);
    const selectors='.guide-main h2,.guide-main h3,.guide-main p,.guide-main td,.guide-main .note,.guide-main .warning,.guide-main .quick-title,.guide-main .quick-tip,.guide-main .step strong';
    const candidates=[...document.querySelectorAll(selectors)];
    const target=candidates.find(node=>normalise(node.textContent)===targetText)||candidates.find(node=>normalise(node.textContent).includes(targetText));
    if(!target)return;
    document.documentElement.dataset.revealedFind=revealKey;
    requestAnimationFrame(()=>{
      target.scrollIntoView({behavior:'smooth',block:'center'});
      target.classList.add('search-arrival-highlight');
      setTimeout(()=>target.classList.remove('search-arrival-highlight'),3200);
    });
  }
  document.addEventListener('astro:page-load',revealSearchedFragment);
  revealSearchedFragment();
</script>
