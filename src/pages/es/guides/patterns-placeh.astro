<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Patterns</title><style>
:root{
  --bg:#060b16;--panel:#0d1528;--panel2:#111b33;--border:#23304d;
  --gold:#d8b56a;--text:#f5f7fb;--muted:#9fb0d0;
}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:radial-gradient(circle at top,#10213f 0%,#060b16 55%);color:var(--text)}
.topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:20px;padding:18px 28px;background:rgba(6,11,22,.92);border-bottom:1px solid rgba(216,181,106,.18);backdrop-filter:blur(10px)}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none;color:inherit}
.crest{width:44px;height:44px;border-radius:14px;border:1px solid rgba(216,181,106,.35);background:linear-gradient(180deg,#1b2848,#0d1528);display:grid;place-items:center;color:var(--gold);font-weight:700}
.brand h1{margin:0;font-size:22px}.brand span{display:block;color:var(--muted);font-size:11px;letter-spacing:.22em}
.top-actions{display:flex;align-items:center;gap:14px;flex:1;justify-content:flex-end}
.search{display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid rgba(216,181,106,.18);border-radius:16px;padding:12px 16px;max-width:620px;flex:1}
.search input{flex:1;background:transparent;border:none;outline:none;color:var(--text)}
.langs{display:flex;gap:8px}
.langs a{padding:10px 14px;border-radius:12px;text-decoration:none;color:white;background:#111b33;border:1px solid #23304d;font-weight:700}
.layout{display:grid;grid-template-columns:260px 1fr;gap:24px;max-width:1440px;margin:0 auto;padding:24px}
.sidebar{position:sticky;top:88px;align-self:start;background:rgba(13,21,40,.86);border:1px solid rgba(216,181,106,.16);border-radius:24px;padding:22px}
.sidebar h3{margin:0 0 16px;color:var(--gold);font-size:14px;letter-spacing:.12em}
.side-link{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;color:var(--text);text-decoration:none;margin-bottom:8px}
.side-link:hover,.side-link.active{background:var(--panel2);border:1px solid rgba(216,181,106,.18)}
.dot{width:8px;height:8px;border-radius:999px;background:var(--gold)}
.promo{margin-top:24px;background:linear-gradient(180deg,#122244,#0d1528);border:1px solid rgba(216,181,106,.18);border-radius:20px;padding:18px;text-align:center}
.promo h4{margin:0 0 8px;color:var(--gold)}.promo p{margin:0 0 16px;color:var(--muted);font-size:14px}
.promo a{display:inline-block;background:linear-gradient(180deg,#d8b56a,#b99046);color:#24180a;text-decoration:none;border-radius:12px;padding:12px 16px;font-weight:700}
.main{display:flex;flex-direction:column;gap:28px}
.hero{border-radius:28px;border:1px solid rgba(216,181,106,.18);background:linear-gradient(90deg, rgba(6,11,22,.92) 0%, rgba(6,11,22,.55) 48%, rgba(6,11,22,.15) 100%), linear-gradient(180deg,#10213f,#060b16);min-height:300px;padding:42px;display:flex;align-items:center}
.hero h2{margin:14px 0;font-size:54px}.hero p{color:#d8e2f6;font-size:17px;line-height:1.6}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 18px;border-radius:14px;text-decoration:none;font-weight:700;border:1px solid rgba(216,181,106,.22);background:rgba(17,27,51,.85);color:var(--text)}
.btn.primary{background:linear-gradient(180deg,#d8b56a,#b99046);color:#24180a}
.section-head h3{margin:0;font-size:30px}.section-head p{margin:6px 0 0;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}
.card-link{text-decoration:none;color:inherit;display:block}
.card{background:rgba(13,21,40,.9);border:1px solid rgba(216,181,106,.16);border-radius:24px;overflow:hidden;height:100%;transition:.18s ease}
.card:hover{transform:translateY(-6px);border-color:rgba(216,181,106,.32);box-shadow:0 18px 40px rgba(0,0,0,.45)}
.card img{width:100%;height:190px;object-fit:cover;display:block}.card-body{padding:18px}
.tag{display:inline-block;color:var(--gold);background:rgba(216,181,106,.1);border:1px solid rgba(216,181,106,.16);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:700;margin-bottom:12px}
.card h4{margin:0 0 10px;font-size:22px}.card p{margin:0 0 16px;color:var(--muted);line-height:1.55}
footer{max-width:1440px;margin:20px auto 40px;padding:0 24px}.footer-box{background:rgba(13,21,40,.86);border:1px solid rgba(216,181,106,.14);border-radius:24px;padding:24px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.footer-box p{margin:0;color:var(--muted)}
.guide-content{max-width:980px;margin:0 auto;background:rgba(13,21,40,.9);border:1px solid rgba(216,181,106,.16);border-radius:24px;padding:28px}
.guide-content img{width:100%;border-radius:18px;margin-bottom:24px}.guide-content h1{font-size:42px;margin-top:0}.guide-content p,.guide-content li{color:#d8e2f6;line-height:1.7}
.back{display:inline-block;margin-bottom:20px;color:#d8e2f6;text-decoration:none}
@media (max-width:980px){.layout{grid-template-columns:1fr}.sidebar{position:relative;top:0}.hero h2{font-size:40px}.topbar{flex-wrap:wrap}.top-actions{width:100%;justify-content:stretch}}
</style></head><body><header class="topbar"><a class="brand" href="/es/"><div class="crest">L2</div><div><h1>L2 Guardian Guides</h1><span>REBORN • GUARDIAN • WIKI</span></div></a><div class="top-actions"><div class="search"><span>🔎</span><input placeholder="Buscar..."></div><div class="langs"><a href="/en/">🇬🇧 EN</a><a href="/es/">🇪🇸 ES</a></div></div></header><div class="guide-content"><a class="back" href="/es/">← Volver al inicio</a><img src="/images/patterns.png" alt="Patterns"><h1>Patterns</h1><p>Contenido de ejemplo para esta guía. Sustitúyelo por tu guía final de Guardian.</p></div></body></html>