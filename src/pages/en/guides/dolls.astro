const toc=[
  {href:'#overview',label:'Overview'},
  {href:'#access',label:'How to Access'},
  {href:'#obtaining',label:'How to Obtain Dolls'},
  {href:'#summoning',label:'Summoning'},
  {href:'#rarities',label:'Rarities and Passive Stats'},
  {href:'#compound',label:'Compounding'},
  {href:'#collections',label:'Collections'},
