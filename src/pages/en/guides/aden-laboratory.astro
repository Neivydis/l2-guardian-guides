---
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Aden Laboratory - L2 Guardian Guides</title>

  <style>
    :root{
      --bg:#060b16;
      --panel:#0d1528;
      --panel2:#111b33;
      --border:#23304d;
      --gold:#d8b56a;
      --text:#f5f7fb;
      --muted:#9fb0d0;
      --green:#3ddc97;
      --red:#ff6b6b;
      --blue:#5ea0ff;
    }

    *{box-sizing:border-box}

    body{
      margin:0;
      font-family:Arial,sans-serif;
      background:radial-gradient(circle at top,#10213f 0%,#060b16 55%);
      color:var(--text);
    }
	.guide-image{
	  width:100%;
	  margin:20px 0;
	  border-radius:16px;
	  border:1px solid rgba(216,181,106,.12);
	  display:block;
	}
	.guide-image-small{
	  width:70%;
	  margin:20px auto;
	  border-radius:16px;
	  border:1px solid rgba(216,181,106,.12);
	  display:block;
	}
	
	.quick-start{
  background:linear-gradient(180deg,#101a31,#0d1528);
}

.quick-head{
  display:flex;
  align-items:center;
  gap:16px;
  margin-bottom:24px;
}

.quick-icon{
  width:52px;
  height:52px;
  border-radius:16px;
  background:rgba(216,181,106,0.12);
  border:1px solid rgba(216,181,106,0.22);
  display:grid;
  place-items:center;
  font-size:24px;
}

.quick-head h2{
  margin:0;
  font-size:28px;
}

.quick-head p{
  margin:4px 0 0;
  color:var(--muted);
}

.quick-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
}

.quick-card{
  background:var(--panel2);
  border:1px solid rgba(216,181,106,0.14);
  border-radius:20px;
  padding:18px;
}

.quick-title{
  color:var(--muted);
  font-size:14px;
  margin-bottom:8px;
}

.quick-value{
  font-size:24px;
  font-weight:700;
  margin-bottom:14px;
}

.quick-tag{
  display:inline-block;
  padding:6px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:700;
}

.quick-tag.high{
  background:rgba(61,220,151,0.12);
  color:#3ddc97;
  border:1px solid rgba(61,220,151,0.24);
}

.quick-tag.medium{
  background:rgba(255,193,7,0.12);
  color:#ffc107;
  border:1px solid rgba(255,193,7,0.24);
}

.quick-footer{
  margin-top:22px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:14px;
}

.quick-tip{
  background:rgba(255,255,255,0.02);
  border:1px solid rgba(216,181,106,0.10);
  border-radius:16px;
  padding:16px;
  color:#d8e2f6;
}

.quick-tip strong{
  display:block;
  color:var(--gold);
  margin-bottom:6px;
}

	
    .topbar{
      position:sticky;
      top:0;
      z-index:50;
      display:flex;
      align-items:center;
      gap:20px;
      padding:18px 28px;
      background:rgba(6,11,22,.92);
      border-bottom:1px solid rgba(216,181,106,.18);
      backdrop-filter:blur(10px);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:14px;
      text-decoration:none;
      color:inherit;
    }

    .crest{
      width:44px;
      height:44px;
      border-radius:14px;
      border:1px solid rgba(216,181,106,.35);
      background:linear-gradient(180deg,#1b2848,#0d1528);
      display:grid;
      place-items:center;
      color:var(--gold);
      font-weight:700;
    }

    .brand h1{
      margin:0;
      font-size:22px;
    }

    .brand span{
      display:block;
      color:var(--muted);
      font-size:11px;
      letter-spacing:.22em;
    }

    .container{
      max-width:1440px;
      margin:0 auto;
      padding:24px;
      display:grid;
      grid-template-columns:280px 1fr;
      gap:24px;
    }

    .sidebar{
      position:sticky;
      top:92px;
      align-self:start;
      background:rgba(13,21,40,.86);
      border:1px solid rgba(216,181,106,.16);
      border-radius:24px;
      padding:22px;
    }

    .sidebar h3{
      margin:0 0 16px;
      color:var(--gold);
      font-size:13px;
      letter-spacing:.14em;
    }

    .toc{
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .toc a{
      color:var(--text);
      text-decoration:none;
      padding:10px 12px;
      border-radius:12px;
      border:1px solid transparent;
      transition:.15s ease;
    }

    .toc a:hover{
      background:var(--panel2);
      border-color:rgba(216,181,106,.18);
    }

    .content{
      display:flex;
      flex-direction:column;
      gap:24px;
    }

    .hero{
      background:linear-gradient(180deg,#132447,#0d1528);
      border:1px solid rgba(216,181,106,.18);
      border-radius:28px;
      overflow:hidden;
    }

    .hero img{
      width:100%;
      height:320px;
      object-fit:cover;
      display:block;
    }

    .hero-body{
      padding:28px;
    }

    .badge{
      display:inline-block;
      background:rgba(216,181,106,.12);
      border:1px solid rgba(216,181,106,.18);
      color:var(--gold);
      padding:6px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      letter-spacing:.04em;
      margin-bottom:14px;
    }

    h1{
      margin:0 0 10px;
      font-size:46px;
      line-height:1.05;
    }

    .subtitle{
      color:#d8e2f6;
      font-size:17px;
      line-height:1.7;
      margin:0;
    }

    .section{
      background:rgba(13,21,40,.9);
      border:1px solid rgba(216,181,106,.16);
      border-radius:24px;
      padding:26px;
    }

    .section h2{
      margin-top:0;
      font-size:30px;
    }

    .section h3{
      margin-top:28px;
      font-size:22px;
    }

    .section p{
      color:#d8e2f6;
      line-height:1.8;
    }

    .info-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:16px;
      margin-top:18px;
    }

    .info-card{
      background:var(--panel2);
      border:1px solid rgba(216,181,106,.14);
      border-radius:18px;
      padding:18px;
    }

    .info-card .label{
      color:var(--muted);
      font-size:13px;
      margin-bottom:6px;
    }

    .info-card .value{
      font-size:20px;
      font-weight:700;
    }

    table{
      width:100%;
      border-collapse:collapse;
      margin-top:18px;
      overflow:hidden;
      border-radius:16px;
    }

    thead{
      background:#152544;
    }

    th,td{
      padding:14px 16px;
      border-bottom:1px solid rgba(216,181,106,.08);
      text-align:left;
    }

    th{
      color:var(--gold);
      font-weight:700;
      font-size:14px;
      letter-spacing:.04em;
    }

    tr:last-child td{
      border-bottom:none;
    }

    .good{color:var(--green);font-weight:700}
    .bad{color:var(--red);font-weight:700}

    .note{
      background:rgba(94,160,255,.08);
      border:1px solid rgba(94,160,255,.22);
      border-radius:18px;
      padding:18px;
      margin-top:18px;
    }

    .warning{
      background:rgba(255,107,107,.08);
      border:1px solid rgba(255,107,107,.22);
      border-radius:18px;
      padding:18px;
      margin-top:18px;
    }

    .steps{
      display:flex;
      flex-direction:column;
      gap:16px;
      margin-top:18px;
    }

    .step{
      display:flex;
      gap:16px;
      align-items:flex-start;
      padding:18px;
      background:var(--panel2);
      border:1px solid rgba(216,181,106,.12);
      border-radius:18px;
    }

    .step .num{
      min-width:38px;
      height:38px;
      border-radius:12px;
      background:#1a2948;
      border:1px solid rgba(216,181,106,.22);
      display:grid;
      place-items:center;
      color:var(--gold);
      font-weight:700;
    }

    .progress{
      margin-top:20px;
      display:grid;
      gap:14px;
    }

    .progress-row{
      display:grid;
      grid-template-columns:90px 1fr 60px;
      align-items:center;
      gap:14px;
    }

    .bar{
      height:10px;
      border-radius:999px;
      background:#14213c;
      overflow:hidden;
    }

    .fill{
      height:100%;
      border-radius:999px;
      background:linear-gradient(90deg,var(--gold),#f5d38a);
    }

    .related{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
      gap:16px;
      margin-top:18px;
    }

    .related a{
      text-decoration:none;
      color:inherit;
      background:var(--panel2);
      border:1px solid rgba(216,181,106,.14);
      border-radius:18px;
      padding:18px;
      transition:.15s ease;
    }

    .related a:hover{
      transform:translateY(-4px);
      border-color:rgba(216,181,106,.28);
    }

    .back{
      display:inline-flex;
      align-items:center;
      gap:8px;
      color:#d8e2f6;
      text-decoration:none;
      margin-bottom:8px;
    }

    @media (max-width: 980px){
      .container{grid-template-columns:1fr}
      .sidebar{position:relative;top:0}
      h1{font-size:38px}
      .hero img{height:220px}
    }
	
	
  </style>
</head>

<body>

<header class="topbar">
  <a class="brand" href="/en/">
    <div class="crest">L2</div>
    <div>
      <h1>L2 Guardian Guides</h1>
    </div>
  </a>
</header>

<div class="container">

  <aside class="sidebar">
    <h3>ON THIS PAGE</h3>

    <nav class="toc">
      <a href="#overview">Overview</a>
	  <a href="#obtaining-reports">Obtaining Reports</a>
      <a href="#how-it-works">How It Works</a>
      <a href="#materials">Materials</a>
      <a href="#stages">Stages &amp; Progress</a>
	  <a href="#tips">Recommendations</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#related">Related Guides</a>
    </nav>
  </aside>

  <main class="content">

    <a class="back" href="/en/">← Back to home</a>

    <section class="hero no-image">

     

      <div class="hero-body">
        <div class="badge">GUARDIAN SYSTEM</div>

        <h1>Aden Laboratory</h1>

        <p class="subtitle">
          Aden Laboratory is a permanent stat system built around researching Queen Ant.
          By spending Exploration Reports and Adena you gradually unlock stage buffs,
          making it one of the best cost-to-power features during the early and mid game.
        </p>

        <div class="info-grid">
          <div class="info-card">
            <div class="label">System Type</div>
            <div class="value">Permanent</div>
          </div>

          <div class="info-card">
            <div class="label">Best For</div>
            <div class="value">Early / Mid Game</div>
          </div>

          <div class="info-card">
            <div class="label">Difficulty</div>
            <div class="value">Low</div>
          </div>

          <div class="info-card">
            <div class="label">Priority</div>
            <div class="value">Medium</div>
          </div>
        </div>
      </div>
    </section>
	
	
	<section class="section quick-start">
  <div class="quick-head">
    <div class="quick-icon">⚡</div>
    <div>
      <h2>Quick Start</h2>
      <p>What to know before opening the Aden Laboratory window for the first time.</p>
    </div>
  </div>

  <div class="quick-grid">

    <div class="quick-card">
      <div class="quick-title">Access</div>
      <div class="quick-value">General Menu</div>
      <span class="quick-tag high">Required</span>
    </div>

    <div class="quick-card">
      <div class="quick-title">Main Cost</div>
      <div class="quick-value">Report + Adena</div>
      <span class="quick-tag high">High Priority</span>
    </div>

    <div class="quick-card">
      <div class="quick-title">Boss Researched</div>
      <div class="quick-value">Queen Ant</div>
      <span class="quick-tag medium">Medium Priority</span>
    </div>

    <div class="quick-card">
      <div class="quick-title">Guardian Change</div>
      <div class="quick-value">Lower Costs</div>
      <span class="quick-tag high">High Priority</span>
    </div>

  </div>

  <div class="quick-footer">

    <div class="quick-tip">
      <strong>Costs decreased</strong>
      Guardian reduced the Adena fee, so the system is worth using much earlier than on retail Essence.
    </div>

    <div class="quick-tip">
      <strong>Free first confirmation</strong>
      Your first confirmation of a rolled effect on a stage is free, so always use it before locking a value.
    </div>

    <div class="quick-tip">
      <strong>Farm reports passively</strong>
      Exploration Reports drop while doing your normal open field farming, so there is no dedicated grinding needed.
    </div>

  </div>
</section>

    <section class="section" id="overview">
      <h2>Overview</h2>

      <p>
        Aden Laboratory is a permanent character system available from the general menu. Inside it you
        conduct research on Queen Ant, and every stage you clear grants a permanent stat-related buff.
        Unlike Patterns or Hidden Power, this system is not paid with a booster that you enchant, it works
        through a card-selection mechanic that consumes Exploration Reports and Adena on every attempt.
      </p>
	<img
	  src="/images/aden-laboratory.png"
	  alt="Aden Laboratory window in Lineage 2 Guardian"
	  class="guide-image-small"/>
      <div class="note">
        <strong>Recommendation:</strong> Open the Aden Laboratory window early, even with just a couple of
        Exploration Reports, since Guardian's reduced costs make it worth starting well before you would on
        a standard Essence server.
      </div>
	 
    </section>
	
	    <section class="section" id="obtaining-reports">
      <h2>Obtaining Reports</h2>

      <p>
        Aden Exploration Reports drop directly from monsters while farming in the open field, so you do not
        need to visit a specific zone to collect them.
		<br>The Adena fee required to use each report on a research attempt has been reduced in Guardian
		compared to standard Essence, which is what makes this feature relevant during the early-mid game
		instead of being a late-game money sink.
      </p>
	  
      <div class="note">
        <strong>Recommendation:</strong> Keep spending your reports as you collect them instead of stockpiling
        them, each attempt either advances a stage or gets you closer to the guaranteed one.
      </div>
    </section>

    <section class="section" id="how-it-works">
      <h2>How It Works</h2>

      <p>
        Each research attempt shows you a set of cards. Selecting a card always consumes one Exploration
        Report plus the Adena fee, regardless of the outcome.
      </p>

      <div class="steps">

        <div class="step">
          <div class="num">1</div>
          <div>
            <strong>Pick a card</strong>
            <p>If the card is not the boss card, it disappears and you simply try again with a different one.</p>
          </div>
        </div>

        <div class="step">
          <div class="num">2</div>
          <div>
            <strong>Find the boss card</strong>
            <p>Selecting the correct card grants that stage's buff and moves you into the special stage for that same buff.</p>
          </div>
        </div>

        <div class="step">
          <div class="num">3</div>
          <div>
            <strong>Refine the effect</strong>
            <p>During the special stage the value of the buff changes on every new research. You can confirm a rolled value to lock it in, and the very first confirmation is free.</p>
          </div>
        </div>

        <div class="step">
          <div class="num">4</div>
          <div>
            <strong>Reach transcendent stages</strong>
            <p>Once every common and special stage is completed, transcendent stages unlock. Upgrading into a transcendent stage is not guaranteed to succeed.</p>
          </div>
        </div>

      </div>

      <div class="warning">
        <strong>Confirmed effects are not automatic.</strong>
        If you do not confirm the rolled value, it disappears the moment you start a new research, so pay attention before queuing another attempt.
      </div>
    </section>

    <section class="section" id="materials">
      <h2>Required Materials</h2>

      <table>
        <thead>
          <tr>
            <th>Material</th>
            <th>Used For</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>Aden Exploration Report</td>
            <td>Spent on every card selection / research attempt</td>
          </tr>
          <tr>
            <td>Adena</td>
            <td>Fee paid alongside each report, reduced in Guardian</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="section" id="stages">
      <h2>Stages &amp; Progress</h2>

      <p>
        Progress in Aden Laboratory always moves forward in the same order: common stages first, then their
        matching special stage to refine the buff value, and only after every stage is cleared do the
        transcendent stages become available.
      </p>

      <div class="note">
        <strong>Recommendation:</strong> Treat the common and special stages as the real priority, since they
        are guaranteed with enough attempts. Transcendent stages are a long-term bonus, not something to farm for immediately.
      </div>
    </section>

    <section class="section" id="tips">
      <h2>Recommendations</h2>

      <div class="steps">

        <div class="step">
          <div class="num">1</div>
          <div>
            <strong>Early game</strong>
            <p>Use every Exploration Report as soon as you get it. The reduced Adena cost in Guardian means there is little reason to wait.</p>
          </div>
        </div>

        <div class="step">
          <div class="num">2</div>
          <div>
            <strong>Mid game</strong>
            <p>Once you are clearing common stages consistently, focus on confirming good rolls during the special stage instead of re-rolling endlessly.</p>
          </div>
        </div>

      </div>
    </section>

    <section class="section" id="mistakes">
      <h2>Common Mistakes</h2>

      <table>
        <thead>
          <tr>
            <th>Mistake</th>
            <th>Impact</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>Hoarding Exploration Reports instead of using them</td>
            <td class="bad">High</td>
          </tr>

          <tr>
            <td>Starting a new research without confirming a good rolled value</td>
            <td class="bad">High</td>
          </tr>

          <tr>
            <td>Ignoring the system because it "looks late game"</td>
            <td class="bad">Medium</td>
          </tr>

          <tr>
            <td>Rushing transcendent stages before clearing common/special ones</td>
            <td>Medium</td>
          </tr>
        </tbody>
      </table>

      <div class="note">
        <strong>Best practice:</strong> Aden Laboratory rewards consistency more than bursts of spending, do a few attempts every time you gather reports instead of saving them for one big session.
      </div>
    </section>

    <section class="section" id="related">
      <h2>Related Guides</h2>

      <div class="related">

        <a href="/en/guides/patterns">
          <strong>Patterns</strong>
          <p>Permanent stat bonuses through the Dye system.</p>
        </a>

        <a href="/en/guides/hidden-power">
          <strong>Hidden Power</strong>
          <p>Optimize long-term progression and damage scaling.</p>
        </a>

        <a href="/en/guides/collections">
          <strong>Collections</strong>
          <p>Permanent account bonuses and efficient priorities.</p>
        </a>

      </div>
    </section>

  </main>
</div>

</body>
</html>
