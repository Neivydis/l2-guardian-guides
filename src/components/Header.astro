---
const { lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const enPath = currentPath.startsWith('/es/') ? currentPath.replace(/^\/es\//, '/en/') : (currentPath.startsWith('/en/') ? currentPath : '/en/');
const esPath = currentPath.startsWith('/en/') ? currentPath.replace(/^\/en\//, '/es/') : (currentPath.startsWith('/es/') ? currentPath : '/es/');
const home = `/${lang}/`;
const labels = lang === 'es' ? {
  search:'Buscar guías, sistemas, objetos...', patterns:'Patterns', hidden:'Hidden Power', aden:'Aden Laboratory', collections:'Collections', dolls:'Dolls', pets:'Guardianes (Pets)'
} : {
  search:'Search guides, systems, items...', patterns:'Patterns', hidden:'Hidden Power', aden:'Aden Laboratory', collections:'Collections', dolls:'Dolls', pets:'Guardians (Pets)'
};
const items = [
  {title:labels.patterns, terms:'patterns dyes stats wit int dex str', href:`/${lang}/guides/patterns`, icon:'/icons/patterns.png'},
  {title:labels.hidden, terms:'hidden power nodes progression damage', href:`/${lang}/guides/hidden-power`, icon:'/icons/hidden-power.png'},
  {title:labels.aden, terms:'aden laboratory research queen ant crafting', href:`/${lang}/guides/aden-laboratory`, icon:'/icons/aden-laboratory.png'},
  {title:labels.collections, terms:'collections bonuses items account', href:`/${lang}/guides/collections`, icon:'/icons/collections.png'},
  {title:labels.dolls, terms:'dolls summon enhancement compounding', href:`/${lang}/guides/dolls`, icon:'/icons/dolls.png'},
  {title:labels.pets, terms:'guardians pets skills evolution books', href:`/${lang}/guides/pets`, icon:'/icons/pets.png'}
];
---
<header class="site-header">
  <a class="site-logo" href={home} aria-label="L2 Reborn home">
    <img src="/images/reborn-logo.png" alt="Reborn - Home of Lineage" />
  </a>
  <div class="search-wrap" data-search-root data-search-href={`/${lang}/search`} data-match-label={lang === 'es' ? 'coincidencias' : 'matches'}>
    <label class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" autocomplete="off" placeholder={labels.search} aria-label={labels.search} data-search-input />
    </label>
    <div class="search-results" data-search-results hidden>
      {items.map(item => <a class="search-result" href={item.href} data-search-item data-terms={`${item.title} ${item.terms}`.toLowerCase()}><img src={item.icon} alt=""/><span class="search-result-copy"><strong>{item.title}</strong><span class="search-preview" data-search-preview></span></span></a>)}
      <div class="search-result" data-search-empty hidden>{lang === 'es' ? 'No se encontraron guías.' : 'No guides found.'}</div>
    </div>
  </div>
  <div class="header-actions">
    <a class="discord-icon" href="https://discord.gg/l2reborn" target="_blank" rel="noopener" aria-label="Discord"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.54 5.34A17.3 17.3 0 0 0 15.22 4l-.53 1.09a16 16 0 0 0-5.36 0L8.78 4a17.5 17.5 0 0 0-4.33 1.35C1.71 9.4.97 13.35 1.34 17.25a17.7 17.7 0 0 0 5.3 2.68l1.28-1.75a11 11 0 0 1-1.67-.81l.41-.32a12.4 12.4 0 0 0 10.68 0l.42.32c-.54.31-1.1.58-1.68.81l1.28 1.75a17.6 17.6 0 0 0 5.3-2.68c.43-4.52-.74-8.43-3.42-11.91ZM8.3 14.87c-1.03 0-1.87-.94-1.87-2.09s.82-2.1 1.87-2.1 1.89.95 1.87 2.1c0 1.15-.83 2.09-1.87 2.09Zm7.4 0c-1.03 0-1.87-.94-1.87-2.09s.82-2.1 1.87-2.1 1.89.95 1.87 2.1c0 1.15-.82 2.09-1.87 2.09Z"/></svg></a>
    <nav class="language-switcher" aria-label="Language">
      <a class:list={['flag-link', {active:lang==='en'}]} href={enPath} title="English" aria-label="English"><svg viewBox="0 0 60 36" aria-hidden="true"><rect width="60" height="36" rx="3" fill="#012169"/><path d="M0 0 60 36M60 0 0 36" stroke="#fff" stroke-width="8"/><path d="M0 0 60 36M60 0 0 36" stroke="#c8102e" stroke-width="4"/><path d="M30 0v36M0 18h60" stroke="#fff" stroke-width="12"/><path d="M30 0v36M0 18h60" stroke="#c8102e" stroke-width="7"/></svg></a>
      <a class:list={['flag-link', {active:lang==='es'}]} href={esPath} title="Español" aria-label="Español"><svg viewBox="0 0 60 36" aria-hidden="true"><rect width="60" height="36" rx="3" fill="#aa151b"/><path d="M0 9h60v18H0z" fill="#f1bf00"/><path d="M14 15h5v8h-5z" fill="#aa151b"/><path d="M12 16h2v6h-2zm7 0h2v6h-2z" fill="#aa151b"/></svg></a>
    </nav>
  </div>
</header>
<script is:inline>
  function setupSiteSearch(){
    document.querySelectorAll('[data-search-root]').forEach(root => {
      if(root.dataset.searchReady) return;
      root.dataset.searchReady='1';
      const input=root.querySelector('[data-search-input]');
      const panel=root.querySelector('[data-search-results]');
      const items=[...root.querySelectorAll('[data-search-item]')];
      const empty=root.querySelector('[data-search-empty]');
      const normalise=value=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
      const extractSentences=doc=>{
        const selectors='.guide-main h2,.guide-main h3,.guide-main p,.guide-main td,.guide-main .note,.guide-main .warning,.guide-main .quick-title,.guide-main .quick-tip,.guide-main .step strong';
        const seen=new Set();
        return [...doc.querySelectorAll(selectors)].flatMap(node=>node.textContent.trim().split(/(?<=[.!?])\s+/)).map(text=>text.replace(/\s+/g,' ').trim()).filter(text=>{
          const key=normalise(text);
          if(text.length<12||seen.has(key)) return false;
          seen.add(key);
          return true;
        });
      };
      const guideIndex=Promise.all(items.map(async item=>{
        try{
          const response=await fetch(item.href);
          if(!response.ok) throw new Error(`HTTP ${response.status}`);
          const doc=new DOMParser().parseFromString(await response.text(),'text/html');
          return {item,sentences:extractSentences(doc)};
        }catch(error){
          console.warn('Guide search indexing failed:',item.href,error);
          return {item,sentences:[]};
        }
      }));
      let revision=0;
      const update=async()=>{
        const currentRevision=++revision;
        const rawQuery=input.value.trim();
        const q=normalise(rawQuery);
        panel.hidden=!q;
        if(!q){items.forEach(item=>item.hidden=true);empty.hidden=true;return;}

        items.forEach(item=>item.hidden=true);
        empty.hidden=true;
        const index=await guideIndex;
        if(currentRevision!==revision) return;

        let visible=0;
        index.forEach(({item,sentences})=>{
          const matches=sentences.filter(sentence=>normalise(sentence).includes(q));
          const titleMatch=normalise(item.dataset.terms).includes(q);
          const match=titleMatch||matches.length>0;
          item.hidden=!match;
          if(!match) return;
          visible++;
          const preview=item.querySelector('[data-search-preview]');
          if(matches.length){
            const bestMatch=matches.find(sentence=>sentence.length>=45)||matches[0];
            preview.textContent=`${bestMatch}${matches.length>1?`  ·  ${matches.length} ${root.dataset.matchLabel}`:''}`;
            preview.hidden=false;
          }else{
            preview.textContent='';
            preview.hidden=true;
          }
        });
        empty.hidden=visible!==0;
      };
      input.addEventListener('input',update);
      input.addEventListener('focus',update);
      input.addEventListener('keydown',e=>{
        if(e.key==='Escape'){panel.hidden=true;input.blur();}
        if(e.key==='Enter'&&input.value.trim()){
          e.preventDefault();
          location.href=`${root.dataset.searchHref}?q=${encodeURIComponent(input.value.trim())}`;
        }
      });
      document.addEventListener('click',e=>{if(!root.contains(e.target))panel.hidden=true;});
    });
  }
  document.addEventListener('astro:page-load',setupSiteSearch);
  setupSiteSearch();
</script>
